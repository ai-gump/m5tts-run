     return runtime::AudioBuffer{kSampleRate, 1, std::move(decoded)};
 }
 
+std::optional<Qwen3SpeechTokenizerDecoderRuntime::StreamStateSnapshot>
+Qwen3SpeechTokenizerDecoderRuntime::snapshot_stream_state() const {
+    if (!stream_state_ || stream_state_->byte_size() == 0) return std::nullopt;
+    StreamStateSnapshot snapshot;
+    snapshot.frames = stream_state_->frames;
+    snapshot.data.resize(stream_state_->byte_size());
+    stream_state_->copy_out(snapshot.data.data());
+    return snapshot;
+}
+
+bool Qwen3SpeechTokenizerDecoderRuntime::restore_stream_state(const StreamStateSnapshot & snapshot) const {
+    if (!stream_state_ || snapshot.data.size() != stream_state_->byte_size()) return false;
+    stream_state_->copy_in(snapshot.data.data());
+    stream_state_->frames = snapshot.frames;
+    return true;
+}
+
 void Qwen3SpeechTokenizerDecoderRuntime::reset_stream() const {
     if (stream_state_ != nullptr) stream_state_->reset();
 }
