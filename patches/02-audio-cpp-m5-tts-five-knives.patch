@@ -249,6 +249,28 @@ public:
         frames = 0;
     }
 
+    size_t byte_size() const {
+        size_t total = 0;
+        for (const auto & kv : tensors_) for (const auto & tv : kv.second) total += ggml_nbytes(tv.tensor);
+        return total;
+    }
+
+    void copy_out(uint8_t * dst) const {
+        for (const auto & kv : tensors_) for (const auto & tv : kv.second) {
+            const size_t n = ggml_nbytes(tv.tensor);
+            ggml_backend_tensor_get(tv.tensor, dst, 0, n);
+            dst += n;
+        }
+    }
+
+    void copy_in(const uint8_t * src) {
+        for (const auto & kv : tensors_) for (const auto & tv : kv.second) {
+            const size_t n = ggml_nbytes(tv.tensor);
+            ggml_backend_tensor_set(tv.tensor, src, 0, n);
+            src += n;
+        }
+    }
+
     int64_t frames = 0;
 
 private:
